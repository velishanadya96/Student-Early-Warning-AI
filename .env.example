# Salin ke .env.local (npm run dev) atau .env (docker compose). Jangan commit file hasil salinan.

# ---- Frontend (npm run dev) ----
# Opsional, hanya lokal: tampilkan dropdown akun demo di halaman login (DEMO_PASSWORD = password seed agar terisi otomatis).
# DEMO_MODE=1
# DEMO_PASSWORD=
# Alamat backend Flask (folder backend/). Di docker compose diisi otomatis.
BACKEND_URL=http://127.0.0.1:5000

# HARUS sama persis dengan JWT_SECRET_KEY backend (minimal 32 karakter). Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Saat `next dev` dan kosong, dipakai secret development bawaan backend (APP_ENV=development).
JWT_SECRET_KEY=

# ---- docker compose (semua service) ----
# Pakai karakter aman untuk URL (huruf, angka, - _ .) karena masuk ke DATABASE_URL.
MYSQL_ROOT_PASSWORD=
# Password akun demo untuk `docker compose exec api python seed.py`. Wajib selain 123456 di production.
SEED_PASSWORD=

# SMTP (opsional). Kosong = pakai Mailpit bawaan compose (email hanya tampil di http://localhost:8025).
# MAIL_HOST=smtp.contoh.id
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_USE_TLS=true
# MAIL_FROM=Student Early Warning <no-reply@contoh.id>

# ---- production (docker-compose.prod.yml), lihat docs/DEPLOY.md ----
# Domain publik (DNS A/AAAA harus sudah mengarah ke server). Untuk uji lokal pakai: localhost
DOMAIN=
# Password user MySQL aplikasi (bukan root). Karakter aman untuk URL.
MYSQL_APP_PASSWORD=
# SMTP asli wajib (verifikasi email dan reset password): MAIL_HOST, MAIL_FROM, dan MAIL_USER/MAIL_PASSWORD bila perlu.
