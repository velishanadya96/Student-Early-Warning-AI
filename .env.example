# MySQL 8 (XAMPP: user root, password kosong). Buat database dulu: lihat database/schema.sql
DATABASE_URL=mysql+pymysql://root:@localhost:3306/student_early_warning
# Untuk coba cepat tanpa MySQL, pakai SQLite:
# DATABASE_URL=sqlite:///sew.db

   JWT_SECRET_KEY=asal-isi-yang-panjang-sekitar-40-huruf-abc123xyz987qwerty
# Alamat front-end yang boleh memanggil API. Isi KEDUANYA bila kadang membuka lewat 127.0.0.1.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Pendaftaran mandiri khusus mahasiswa (akun dosen/kaprodi/admin dibuat Admin lewat POST /api/v1/users)
ALLOW_SELF_REGISTER=true

# --- Verifikasi email ---
# true  = mahasiswa/orang tua yang daftar sendiri wajib klik tautan di email sebelum bisa login.
# false = langsung aktif (berguna kalau SMTP belum siap saat demo).
EMAIL_VERIFICATION_REQUIRED=true
# Alamat front-end (dipakai membuat tautan di email).
FRONTEND_URL=http://localhost:3000
# SMTP (contoh Gmail: smtp.gmail.com, port 587, password = "App Password"). KOSONGKAN SMTP_HOST untuk mode dev:
# tautan verifikasi dicetak di terminal Flask, tidak ada email yang dikirim.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Student Early Warning AI <no-reply@sew.local>

# --- Penguncian akun ---
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Login & daftar dengan Google ---
# Buat OAuth Client ID (tipe "Web application") di https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:3000 dan http://127.0.0.1:3000
# Kosong = fitur Google nonaktif (daftar memakai verifikasi email lewat tautan).
GOOGLE_CLIENT_ID=220371354336-3b0u6b4v2etue6h71p3fvj2scfbgbba4.apps.googleusercontent.com
# Batasi domain email (pisah koma). Kosong = semua akun Google boleh. Contoh: student.uns.ac.id
ALLOWED_EMAIL_DOMAINS=
