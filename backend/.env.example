# Lingkungan: development | production. Default (kalau kosong) = production, yang MENOLAK start
# tanpa JWT_SECRET_KEY yang kuat. Untuk lokal pakai development.
APP_ENV=development

# MySQL 8 (XAMPP: user root, password kosong). Buat database dulu: lihat database/schema.sql
DATABASE_URL=mysql+pymysql://root:@localhost:3306/student_early_warning
# Untuk coba cepat tanpa MySQL, pakai SQLite:
# DATABASE_URL=sqlite:///sew.db

# Wajib di production: string acak minimal 32 karakter.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Nilai ini juga dipakai frontend (JWT_SECRET_KEY di .env.local Next.js) untuk memverifikasi token.
JWT_SECRET_KEY=

CORS_ORIGINS=http://localhost:3000
# Dipakai untuk membuat tautan di email verifikasi / reset password
FRONTEND_URL=http://localhost:3000

# Pendaftaran mandiri khusus mahasiswa (akun dosen/kaprodi/admin dibuat Admin lewat POST /api/v1/users)
ALLOW_SELF_REGISTER=true
# Mahasiswa yang mendaftar sendiri harus memverifikasi email lebih dulu
REQUIRE_EMAIL_VERIFICATION=true

# SMTP untuk email verifikasi/reset. Kosong = email TIDAK dikirim, tautannya dicetak di log server (cukup untuk lokal).
# Untuk mencoba kotak surat tiruan: jalankan `docker run -p 8025:8025 -p 1025:1025 axllent/mailpit`
# lalu MAIL_HOST=localhost, MAIL_PORT=1025, MAIL_USE_TLS=false dan buka http://localhost:8025
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM=Student Early Warning <no-reply@sew.local>

# Berapa proxy tepercaya di depan API (frontend/Nginx). 0 = abaikan X-Forwarded-For. Isi 1 bila dipanggil lewat frontend
# di jaringan tertutup; JANGAN isi bila API terbuka langsung ke internet (header bisa dipalsukan).
TRUSTED_PROXIES=0

# Penguncian akun setelah salah password berulang
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15

# Password akun demo untuk seed.py (wajib selain 123456 di production)
# SEED_PASSWORD=
